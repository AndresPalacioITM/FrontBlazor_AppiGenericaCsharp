@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthService AuthService
@using FrontBlazor_AppiGenericaCsharp.Services

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span>Frontend Blazor - API GenericaCsharp</span>

            @if (isAuthenticated)
            {
                <span class="text-light me-2">Hola, @userEmail</span>
                <button class="btn btn-sm btn-danger" @onclick="Logout">Cerrar sesión</button>
            }
            else
            {
                <a href="/login" class="btn btn-sm btn-primary">Iniciar sesión</a>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>

        <footer class="border-top mt-4 pt-3 text-center text-muted small">
            <span class="fw-light">🚀 Equipo de desarrollo:</span>
            <span>Andres Eduardo Palacio Del Rio</span>
            <span class="mx-1">·</span>
            <span>Jorge Andres Morales Nuñez</span>
            <span class="mx-1">·</span>
            <span>Miguel Ángel Jaramillo Agudelo</span>
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool isAuthenticated = false;
    private string userEmail = "";
    private bool isLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var token = await AuthService.GetToken();
            if (!string.IsNullOrEmpty(token))
            {
                isAuthenticated = true;
                // Opcional: obtener email del token si lo tienes
                userEmail = "Usuario";
            }
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task Logout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/login", true);
    }
}