@inherits LayoutComponentBase
@inject NavigationManager Navigation
@using FrontBlazor_AppiGenericaCsharp.Services

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span>Frontend Blazor - API GenericaCsharp</span>
            <AuthNavMenu /> @* BOton de cerrar sesion*@
        </div>

        <article class="content px-4">
            @Body
        </article>

        <!-- Footer: aparece en todas las páginas -->
        <footer class="border-top mt-4 pt-3 text-center text-muted small">
            <span class="fw-light">🚀 Equipo de desarrollo:</span>
            <span>Andres Eduardo Palacio Del Rio</span>
            <span class="mx-1">·</span>
            <span>Jorge Andres Morales Nuñez</span>
            <span class="mx-1">·</span>
            <span>Miguel Ángel Jaramillo Agudelo</span>
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override async Task OnInitializeAsync()
    {
        var token = await LocalStorageService.GetTokenAsync();
        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login", true);
        }
    }
}