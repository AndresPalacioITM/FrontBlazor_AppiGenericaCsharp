@page "/"
@using Microsoft.AspNetCore.Authorization
@inherits AuthenticatedPageBase

<PageTitle>CRUD proyecto Aula</PageTitle>

<div class="container mt-4">
    <h1>CRUD - Base de Datos Proyecto Clase de Aplicacion y Servicio Web </h1>
    <p class="lead">
        Frontend Blazor que consume la API generica
        <strong>ApiGenericaCsharp</strong> para gestionar las tablas
        de <code>MiDB_sqlserver_local</code>.
    </p>

    <div class="alert alert-info">
        <strong>Tablas disponibles:</strong> Tipo Producto, Proyecto, Termino Clave, Ac Proyecto, Docente_producto, Productom, Ods, Area Conocimiento, Area Aplicacion, Aliado, Aliado Proyecto. <br />
        <br />
        Use el menu lateral para navegar cada una de las tablas y realizar operaciones CRUD (Crear, Leer, Actualizar, Eliminar) sobre los registros.
    </div>
</div>