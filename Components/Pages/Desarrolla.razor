@page "/Desarrolla"
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Desarrolla - Asignación de Docentes a Proyectos</PageTitle>

<div class="container mt-4">
    <h3>Asignación de Docentes a Proyectos</h3>

    @* Alertas *@
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @* Botón Nuevo *@
    @if (!mostrarFormulario)
    {
        <button class="btn btn-primary mb-3" @onclick="NuevoRegistro">+ Nueva Asignación</button>
    }

    @* FORMULARIO *@
    @if (mostrarFormulario)
    {
        <div class="card mb-3">
            <div class="card-header">
                @(editando ? "Editar Asignación" : "Nueva Asignación")
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Docente</label>
                        <select class="form-select" @bind="campoDocente">
                            <option value="0">-- Seleccione un docente --</option>
                            @foreach (var doc in listaDocentes)
                            {
                                var cedula = Convert.ToInt32(doc["cedula"]);
                                var nombreCompleto = $"{doc["nombres"]} {doc["apellidos"]} (C.C. {cedula})";
                                <option value="@cedula">@nombreCompleto</option>
                            }
                        </select>
                        <small class="text-muted">Seleccione el docente que participa en el proyecto</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Proyecto</label>
                        <select class="form-select" @bind="campoProyecto">
                            <option value="0">-- Seleccione un proyecto --</option>
                            @foreach (var proy in listaProyectos)
                            {
                                var idProy = Convert.ToInt32(proy["id"]);
                                var titulo = proy["titulo"]?.ToString();
                                <option value="@idProy">@idProy - @titulo</option>
                            }
                        </select>
                        <small class="text-muted">Seleccione el proyecto al que se asigna</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Rol en el proyecto</label>
                        <select class="form-select" @bind="campoRol">
                            <option value="">-- Seleccione un rol --</option>
                            <option value="Investigador principal">Investigador principal</option>
                            <option value="Coinvestigador">Coinvestigador</option>
                            <option value="Auxiliar de investigación">Auxiliar de investigación</option>
                        </select>
                        <small class="text-muted">Seleccione su rol dentro del proyecto</small>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold">Descripción de actividades</label>
                        <textarea class="form-control" rows="4" @bind="campoDescripcion" 
                                  placeholder="Ej: Encargado del análisis de datos, redacción de informes, etc."></textarea>
                        <small class="text-muted">Coloque las actividades realizadas en el proyecto</small>
                    </div>
                </div>

                <button class="btn btn-success me-2" @onclick="GuardarRegistro">Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    }

    @* Spinner *@
    @if (cargando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }

    @* TABLA *@
    @if (!cargando && registros.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Docente (Cédula)</th>
                    <th>Proyecto (ID)</th>
                    <th>Rol</th>
                    <th>Descripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in registros)
                {
                    <tr>
                        <td>@reg["docente"]</td>
                        <td>@reg["proyecto"]</td>
                        <td>@reg["rol"]</td>
                        <td>@reg["descripcion"]</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1" @onclick="() => EditarRegistro(reg)">Editar</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarRegistro(reg)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!cargando && !registros.Any())
    {
        <div class="alert alert-info">No hay asignaciones de docentes a proyectos. Cree una nueva.</div>
    }
</div>

@code {
    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> listaDocentes = new();
    private List<Dictionary<string, object?>> listaProyectos = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;

    // Campos del formulario
    private int campoDocente = 0;
    private int campoProyecto = 0;
    private string campoRol = string.Empty;
    private string campoDescripcion = string.Empty;

    // Guardamos la clave original para editar (porque la usamos como identificador)
    private int proyectoOriginal = 0;
    private int docenteOriginal = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarCatalogos();
        await CargarRegistros();
    }

    private async Task CargarCatalogos()
    {
        try
        {
            var docentes = await Api.ListarAsync("docente");
            listaDocentes = docentes ?? new();
            var proyectos = await Api.ListarAsync("proyecto");
            listaProyectos = proyectos ?? new();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar catálogos: {ex.Message}";
            exito = false;
        }
    }

    private async Task CargarRegistros()
    {
        cargando = true;
        try
        {
            var resultado = await Api.ListarAsync("desarrolla");
            registros = resultado ?? new();
        }
        catch (Exception ex)
        {
            registros = new List<Dictionary<string, object?>>();
            mensaje = $"No hay registros disponibles, por favor cree uno nuevo. Detalles del error: {ex.Message}";
            exito = false;
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevoRegistro()
    {
        editando = false;
        campoDocente = 0;
        campoProyecto = 0;
        campoRol = string.Empty;
        campoDescripcion = string.Empty;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        editando = true;
        campoDocente = Convert.ToInt32(reg["docente"]);
        campoProyecto = Convert.ToInt32(reg["proyecto"]);
        campoRol = reg["rol"]?.ToString() ?? "";
        campoDescripcion = reg["descripcion"]?.ToString() ?? "";

        // Guardamos los valores originales (clave compuesta)
        docenteOriginal = campoDocente;
        proyectoOriginal = campoProyecto;

        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private async Task GuardarRegistro()
    {
        if (campoDocente == 0 || campoProyecto == 0)
        {
            mensaje = "Debe seleccionar un docente y un proyecto.";
            exito = false;
            return;
        }

        var datos = new Dictionary<string, object?>
        {
            ["docente"] = campoDocente,
            ["proyecto"] = campoProyecto,
            ["rol"] = campoRol,
            ["descripcion"] = campoDescripcion
        };

        if (editando)
        {
            // Usamos "proyecto" como campo clave (no es ideal, pero funciona con tu API actual)
            // Para evitar errores, primero eliminamos el registro original y luego insertamos el nuevo
            // O bien, si el proyecto no cambió, podemos actualizar solo los campos no clave.
            // Como tu API no soporta clave compuesta, haremos DELETE + INSERT.
            var eliminar = await Api.EliminarAsync("desarrolla", "proyecto", proyectoOriginal.ToString());
            if (eliminar.exito)
            {
                var crear = await Api.CrearAsync("desarrolla", datos);
                exito = crear.exito;
                mensaje = crear.mensaje;
            }
            else
            {
                exito = false;
                mensaje = "No se pudo eliminar el registro anterior.";
            }
        }
        else
        {
            var resultado = await Api.CrearAsync("desarrolla", datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }

        if (exito)
        {
            mostrarFormulario = false;
            await CargarRegistros();
        }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        int proyecto = Convert.ToInt32(reg["proyecto"]);
        var resultado = await Api.EliminarAsync("desarrolla", "proyecto", proyecto.ToString());
        exito = resultado.exito;
        mensaje = resultado.mensaje;
        if (exito)
        {
            await CargarRegistros();
        }
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        mensaje = string.Empty;
    }
}