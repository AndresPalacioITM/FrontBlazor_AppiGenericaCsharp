@page "/Desarrolla"
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Desarrolla</PageTitle>
<div>
    <h3>Tabla Desarrolla</h3>
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @if (!mostrarFormulario)
    {
        <button class="btn btn-primary mb-3" @onclick="NuevoRegistro">Nuevo Registro</button>
    }

    @if (mostrarFormulario)
    {
        <div class="card mb-3">
            <div class="card-header">
                @(editando ? "Editar Registro" : "Nuevo Registro")
            </div>
            <div class="card-body">
                <div class="row">

                    <div class="col-md-6">
                        <label class="form-label">Docente</label>
                        <input class="form-control" type="number" @bind="campoDocente"/>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Proyecto</label>
                        <input class="form-control" type="number" @bind="campoProyecto"/>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Rol</label>
                        <input class="form-control" @bind="campoRol"/>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Descripción</label>
                        <input class="form-control" @bind="campoDescripcion"/>
                    </div>

                </div>

                <button class="btn btn-success mt-2" @onclick="GuardarRegistro">Guardar</button>
                <button class="btn btn-secondary mt-2" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    }

    @if (cargando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }

    @if (!cargando && registros.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Docente</th>
                    <th>Proyecto</th>
                    <th>Rol</th>
                    <th>Descripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in registros)
                {
                    <tr>
                        <td>@reg["docente"]</td>
                        <td>@reg["proyecto"]</td>
                        <td>@reg["rol"]</td>
                        <td>@reg["descripcion"]</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1" @onclick="() => EditarRegistro(reg)">Editar</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarRegistro(reg)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!cargando && !registros.Any())
    {
        <div class="alert alert-info">
            No se encontraron registros en la tabla desarrolla. Haga clic en "Nuevo" para agregar uno.
        </div>
    }
</div>

@code
{
    private List<Dictionary<string, object?>> registros = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;

    private int campoDocente = 0;
    private int campoProyecto = 0;
    private string campoRol = string.Empty;
    private string campoDescripcion = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarRegistros();
    }

    private async Task CargarRegistros()
    {
        try
        {
            var resultado = await Api.ListarAsync("desarrolla");
            registros = resultado ?? new List<Dictionary<string, object?>>();
        }
        catch (Exception ex)
        {
            registros = new List<Dictionary<string, object?>>();
            mensaje = $"Error al cargar registros: {ex.Message}";
            exito = false;
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevoRegistro()
    {
        editando = false;
        campoDocente = 0;
        campoProyecto = 0;
        campoRol = string.Empty;
        campoDescripcion = string.Empty;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        editando = true;
        campoDocente = int.TryParse(reg["docente"]?.ToString(), out int d) ? d : 0;
        campoProyecto = int.TryParse(reg["proyecto"]?.ToString(), out int p) ? p : 0;
        campoRol = reg["rol"]?.ToString() ?? "";
        campoDescripcion = reg["descripcion"]?.ToString() ?? "";
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private async Task GuardarRegistro()
    {
        var datos = new Dictionary<string, object?>
        {
            ["docente"] = campoDocente,
            ["proyecto"] = campoProyecto,
            ["rol"] = campoRol,
            ["descripcion"] = campoDescripcion
        };

        if (editando)
        {
            var resultado = await Api.ActualizarAsync("desarrolla", "proyecto", campoProyecto.ToString(), datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }
        else
        {
            var resultado = await Api.CrearAsync("desarrolla", datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }

        if (exito)
        {
            await CargarRegistros();
            mostrarFormulario = false;
        }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        string id = reg["proyecto"]?.ToString() ?? string.Empty;

        var resultado = await Api.EliminarAsync("desarrolla", "proyecto", id);
        exito = resultado.exito;
        mensaje = resultado.mensaje;

        if (exito)
        {
            await CargarRegistros();
        }
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        mensaje = string.Empty;
    }
}