@page "/Docente_producto"
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Docente_producto</PageTitle>
<div class="contaier mt-4">>
    <h3>Docente_producto</h3>
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }
    @if (!mostrarFormulario)
    {
        <button class="btn btn-primary mb-3" @onclick="NuevoRegistro">Nuevo Docente_producto</button>
    }
    @if (mostrarFormulario)
    {
        <div class="card mb-3">
            <div class="card-header">
                @(editando ? "Editar Docente_producto" : "Nuevo Docente_producto")
            </div>
            <div class="car-body">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label">Docente</label>
                        <input class="form-control" type="number" @bind="campoDocente" disabled="@editando"/>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Producto</label>
                        <input class="form-control" type="number" @bind="campoProducto"/>
                    </div>
                </div>
                <button class="btn btn-success" @onclick="GuardarRegistro">Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    }
    @if (cargando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    @if(!cargando && registros.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Docente</th>
                    <th>Producto</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in registros)
                {
                    <tr>
                        <td>@reg["docente"]</td>
                        <td>@reg["producto"]</td>
                        <td>
                            <button class="btn btn-sm btn-warning me-2" @onclick="() => EditarRegistro(reg)">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => EliminarRegistro(reg)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    @if(!cargando && !registros.Any())
    {
        <div class="alert alert-info">No hay registros para mostrar en la tabla Docente Producto. Haz clic en "Nuevo Docente_producto" para agregar uno.</div>
    }
</div>
@code
{
    private List<Dictionary<string, object?>> registros = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;

    private int campoDocente = 0;
    private int campoProducto = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarRegistros();
    }

    private async Task CargarRegistros()
    {
        try
        {
            var resultado = await Api.ListarAsync("docente_producto");
            registros = resultado ?? new List<Dictionary<string, object?>>();
        }
        catch (Exception ex)
        {
            registros = new List<Dictionary<string, object?>>();
            mensaje = $"Error al cargar registros: {ex.Message}";
            exito = false;
        }
        finally
        {
            cargando = false;
        }
    }
    private void NuevoRegistro()
    {
        editando = false;
        campoDocente = 0;
        campoProducto = 0;
        mostrarFormulario = true; 
        mensaje = string.Empty;
    }
    private void EditarRegistro(Dictionary<string, object?> reg)
        {
            editando = true;
            campoDocente = int.TryParse(reg["docente"]?.ToString(), out int docente) ? docente : 0;
            campoProducto = int.TryParse(reg["producto"]?.ToString(), out int producto) ? producto : 0;
            mostrarFormulario = true;
            mensaje = string.Empty;
        }
    private async Task GuardarRegistro()
    {
        var datos = new Dictionary<string, object?>
        {
            ["docente"] = campoDocente,
            ["producto"] = campoProducto
        };
        if(editando)
        {
            datos.Remove("docente");
            var resultado = await Api.ActualizarAsync("docente_producto","docente", campoDocente.ToString(), datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }
        else
        {
            var resultado = await Api.CrearAsync("docente_producto", datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }
        if(exito)
        {
            await CargarRegistros();
            mostrarFormulario = false;
        }        
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        string id = reg["docente"]?.ToString() ?? string.Empty;
        var resultado = await Api.EliminarAsync("docente_producto", "docente", id);
        exito = resultado.exito;
        mensaje = resultado.mensaje;
        if (exito)
        {
            await CargarRegistros();
        }
    }
    private void Cancelar()
    {
        mostrarFormulario = false;
        mensaje = string.Empty; 
    }

}