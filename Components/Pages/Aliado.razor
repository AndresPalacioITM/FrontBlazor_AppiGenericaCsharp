@page "/Aliado"
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Aliado</PageTitle>

<div class="container mt-4">
    <h3>Aliado</h3>

    @* ───────── ALERTA DE EXITO O ERROR ───────── *@
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }
    @* ───────── BOTON PARA MOSTRAR FORMULARIO DE CREAR ───────── *@
    @if (!mostrarFormulario)
    {
        <button class="btn btn-primary mb-3" @onclick="NuevoRegistro">+ Nuevo Aliado</button>
    }
    @* ───────── FORMULARIO (CREAR / EDITAR) ───────── *@
    @if (mostrarFormulario)
    {
        <div class="card mb-3">
            <div class="card-header">
                @(editando ? "Editar Aliado" : "Nuevo Aliado")
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nit</label>
                        <input class="form-control" type="number" @bind="campoNit" disabled="@editando" />
                        <small class="text-muted">Ingrese el número de identificación tributaria (NIT)</small>                        
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Razon_social</label>
                        <input class="form-control" @bind="campoRazonSocial" />
                        <small class="text-muted">Ingrese el nombre de la institución aliada con la que realizó el proyecto</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nombre_contacto</label>
                        <input class="form-control" @bind="campoNombreContacto" />
                        <small class="text-muted">Ingrese el nombre del contacto</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Correo</label>
                        <input class="form-control" type="email" @bind="campoCorreo" />
                        <small class="text-muted">Ingrese el correo electrónico del contacto</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class ="form-label">Telefono</label>
                        <input class="form-control" @bind="campoTelefono" />
                        <small class="text-muted">Ingrese el número de teléfono del contacto</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class ="form-label">Ciudad</label>
                        <input class="form-control" @bind="campoCiudad" />
                        <small class="text-muted">Ingrese la ciudad del contacto</small>
                    </div>                    
                </div>
                <button class="btn btn-success me-2" @onclick="GuardarRegistro">Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    }
    @if (cargando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    @* ───────── TABLA DE REGISTROS ───────── *@
    @if (!cargando && registros.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Nit</th>
                    <th>Razon_social</th>
                    <th>Nombre_contacto</th>
                    <th>Correo</th>
                    <th>Telefono</th>
                    <th>Ciudad</th>                    
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in registros)
                {
                    <tr>
                        <td>@reg["nit"]</td>
                        <td>@reg["razon_social"]</td>
                        <td>@reg["nombre_contacto"]</td>
                        <td>@reg["correo"]</td>
                        <td>@reg["telefono"]</td>
                        <td>@reg["ciudad"]</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1"
                                    @onclick="() => EditarRegistro(reg)">
                                Editar
                            </button>
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => EliminarRegistro(reg)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
     @* ───────── MENSAJE CUANDO NO HAY DATOS ───────── *@
    @if (!cargando && !registros.Any())
    {
        <div class="alert alert-warning">No se encontraron registros en la tabla aliado.</div>
    }
</div>
@code 
{
    // ───────── VARIABLES DE ESTADO ─────────

    // Lista de registros obtenidos de la API
    private List<Dictionary<string, object?>> registros = new();
    // Controla si se muestra el spinner de carga
    private bool cargando = true;
    // Controla si se muestra el formulario
    private bool mostrarFormulario = false;
    // Indica si estamos editando (true) o creando (false)
    private bool editando = false;
    // Mensaje de alerta para el usuario
    private string mensaje = string.Empty;
    // Indica si la ultima operacion fue exitosa (para color de alerta)
    private bool exito = false;
        // Campos del formulario
    private int campoNit = 0;
    private string campoRazonSocial = string.Empty;
    private string campoNombreContacto = string.Empty;
    private string campoCorreo = string.Empty;
    private string campoTelefono = string.Empty;
    private string campoCiudad = string.Empty;

    // ───────── CICLO DE VIDA ─────────

    // Se ejecuta al cargar la pagina por primera vez
    protected override async Task OnInitializedAsync()
    {
        await CargarRegistros();
    }
     // ───────── METODOS ─────────

    // Obtiene todos los registros de la tabla producto
    private async Task CargarRegistros()
    {
        cargando = true;
        mensaje = string.Empty;
        try
        {
            var resultado = await Api.ListarAsync("aliado");
            registros = resultado ?? new List<Dictionary<string, object?>>();
             // Si la respuesta es nula, inicializa con lista vacia
        }
        catch (Exception ex)
        {
            registros = new List<Dictionary<string, object?>>();
            mensaje = $"Error al cargar los datos: {ex.Message}";
                exito = false;
        }
        finally
        {
            cargando = false;
        }        
    }
     // Muestra el formulario vacio para crear un nuevo registro
    private void NuevoRegistro()
    {
        editando = false;
        campoNit= 0;
        campoRazonSocial = string.Empty;
        campoNombreContacto = string.Empty;
        campoCorreo = string.Empty;
        campoTelefono = string.Empty;
        campoCiudad = string.Empty;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }
    // Llena el formulario con los datos del registro seleccionado
    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        editando = true;
        campoNit = int.TryParse(reg["nit"]?.ToString(), out int nit) ? nit : 0;
        campoRazonSocial = reg["razon_social"]?.ToString() ?? "";
        campoNombreContacto = reg["nombre_contacto"]?.ToString() ?? "";
        campoCorreo = reg["correo"]?.ToString() ?? "";
        campoTelefono = reg["telefono"]?.ToString() ?? "";
        campoCiudad = reg["ciudad"]?.ToString() ?? "";
        mostrarFormulario = true;
        mensaje = string.Empty;
    }
     // Crea o actualiza un registro segun el modo (editando o creando)
    private async Task GuardarRegistro()
    {
        // Arma el diccionario con los datos del formulario
        var datos = new Dictionary<string, object?>
        {
            
            ["nit"] = campoNit,
            ["razon_social"] = campoRazonSocial,
            ["nombre_contacto"] = campoNombreContacto,
            ["correo"] = campoCorreo,
            ["telefono"] = campoTelefono,
            ["ciudad"] = campoCiudad
        };

        if (editando)
        {
            // PUT /api/objetivo_desarrollo_sostenible/id/{valor}
            // No incluimos el id en los datos porque es la clave
            datos.Remove("nit");
            var resultado = await Api.ActualizarAsync("aliado", "nit", campoNit.ToString(), datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        };

        if (editando)
        {
            // PUT /api/aliado/nit/{valor}
            
            datos.Remove("nit");
            var resultado = await Api.ActualizarAsync("aliado", "nit", campoNit.ToString(), datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }
        else
        {
            // POST /api/aliado
            var resultado = await Api.CrearAsync("aliado", datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }

        if (exito)
        {
            mostrarFormulario = false;
            await CargarRegistros(); // Recargar la tabla
        }
    }
     // Elimina un registro despues de confirmacion
    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        string nit = reg["nit"]?.ToString() ?? "";

        // DELETE /api/aliado/nit/{valor}
        var resultado = await Api.EliminarAsync("aliado", "nit", nit); 
        exito = resultado.exito;
        mensaje = resultado.mensaje;

        if (exito)
        {
            await CargarRegistros(); // Recargar la tabla
        }
    }

    // Oculta el formulario sin guardar
    private void Cancelar()
    {
        mostrarFormulario = false;
        mensaje = string.Empty;
    }
}

