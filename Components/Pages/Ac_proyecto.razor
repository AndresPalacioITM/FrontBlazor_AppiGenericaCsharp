@page "/Ac_proyecto"
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Area de conocimiento - Proyecto</PageTitle>
<div>
    <h3>Area de conocimiento - Proyecto</h3>
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }
    @if (!mostrarFormulario)
    {
        <button class="btn btn-primary mb-3" @onclick="NuevoRegistro">+ Nuevo Ac_proyecto</button>
    }
    @if (mostrarFormulario)
    {
        <div class="card mb-3">
            <div class="card-header">
                @(editando ? "Editar Ac_proyecto" : "Nuevo Ac_proyecto")
            </div>
            <div class="car-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Proyecto</label>
                        <select class="form-control" @bind="campoProyecto">
                            <option value="0">-- Seleccione un proyecto --</option>
                            @foreach (var proyecto in listaProyectos)
                            {
                                var idProyecto = Convert.ToInt32(proyecto["id"]);
                                var nombreProyecto = proyecto["titulo"]?.ToString() ?? $"Proyecto {idProyecto}";
                                <option value="@idProyecto">@nombreProyecto</option>
                            }
                        </select>
                        <small class="text-muted">Seleccione el proyecto</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Area de conocimiento</label>
                        <select class="form-control" @bind="campoAreaConocimiento">
                            <option value="0">-- Seleccione un área de conocimiento --</option>
                            @foreach (var area in listaAreasConocimiento)
                            {
                                var idArea = Convert.ToInt32(area["id"]);
                                var nombreArea = $"{area["gran_area"]} - {area["area"]} - {area["disciplina"]}";
                                <option value="@idArea">@nombreArea</option>
                            }
                        </select>
                        <small class="text-muted">Seleccione el área de conocimiento</small>
                    </div>
                </div>
                <button class="btn btn-success" @onclick="GuardarRegistro">Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    }
    @if (cargando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    @if (!cargando && registros.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Proyecto</th>
                    <th>Area de Conocimiento</th>   
                    <th>Acciones</th>                 
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in registros)
                {
                    <tr>
                        <td>@reg["proyecto"]</td>
                        <td>@reg["area_conocimiento"]</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1" @onclick="() => EditarRegistro(reg)">Editar</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarRegistro(reg)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    @if (!cargando && !registros.Any())
    {
        <div class="alert alert-info">No se encontraron registros en la tabla de Area de conocimiento - proyecto. Haga clic en "Nuevo" para agregar uno.</div>
    }
</div>
@code
{
    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> listaProyectos = new();
    private List<Dictionary<string, object?>> listaAreasConocimiento = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;
    private int campoProyecto = 0;
    private int campoAreaConocimiento = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarCatalogos();
        await CargarRegistros();
    }

    private async Task CargarCatalogos()
    {
        try
        {
            var proyecto = await Api.ListarAsync("proyecto");
            listaProyectos = proyecto ?? new();
            var areaConocimiento = await Api.ListarAsync("area_conocimiento");
            listaAreasConocimiento = areaConocimiento ?? new();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar catálogos: {ex.Message}";
            exito = false;
        }
    }

    private async Task CargarRegistros()
    {
        try
        {
            var resultado = await Api.ListarAsync("ac_proyecto");            
            registros = resultado ?? new List<Dictionary<string, object?>>();
        }
        catch (Exception ex)
        {
            registros = new List<Dictionary<string, object?>>();
            mensaje = $"Error al cargar registros: {ex.Message}";
            exito = false;
        }
        finally
        {
            cargando = false;
        }
    }
    private void NuevoRegistro()
    {
        editando = false;
        campoProyecto = 0;
        campoAreaConocimiento = 0;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }
    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        editando = true;
        campoProyecto = Convert.ToInt32(reg["proyecto"]);
        campoAreaConocimiento = Convert.ToInt32(reg["area_conocimiento"]);
        mostrarFormulario = true;
        mensaje = string.Empty;
    }
    private async Task GuardarRegistro()
        {
            //validacion de campos
            if (campoProyecto <= 0 ){mensaje = "Debe seleccionar un proyecto valido."; exito = false; return;}
            if (campoAreaConocimiento <= 0 ){mensaje = "Debe seleccionar un área de conocimiento valida."; exito = false; return;}

            //validacion para nuevos registros
            if (!editando){bool yaExiste = registros.Any(r => Convert.ToInt32(r["proyecto"]) == campoProyecto && Convert.ToInt32(r["area_conocimiento"]) == campoAreaConocimiento);
                if (yaExiste ){mensaje = "Ya existe una relacion entre ese proyecto y esa area de conocimiento. No se puede duplicar."; exito = false; return;}}
            var datos = new Dictionary<string, object?>
                {
                    ["proyecto"] = campoProyecto,
                    ["area_conocimiento"] = campoAreaConocimiento
                };
                if (editando)
                {
                    //PUT
                    var resultado = await Api.ActualizarAsync("ac_proyecto", "proyecto", campoProyecto.ToString(), datos);
                    exito = resultado.exito;
                    mensaje = resultado.mensaje;
                }
                else
                {
                    //POST
                    var resultado = await Api.CrearAsync("ac_proyecto", datos);
                    exito = resultado.exito;
                    mensaje = resultado.mensaje;
                }
                if (exito)
                {
                    await CargarRegistros();
                    mostrarFormulario = false;
                }
        }
        private async Task EliminarRegistro(Dictionary<string, object?> reg)
            {
                string id = reg["proyecto"]?.ToString() ?? string.Empty;
                var resultado = await Api.EliminarAsync("ac_proyecto", "proyecto", id);
                exito = resultado.exito;
                mensaje = resultado.mensaje;
                if (exito)
                {
                    await CargarRegistros();
                }
            }
            private void Cancelar()
            {
                mostrarFormulario = false;
                mensaje = string.Empty;
            }
}