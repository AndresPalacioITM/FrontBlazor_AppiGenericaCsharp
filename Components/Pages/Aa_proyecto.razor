@page "/Aa_proyecto"
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Area de aplicacion - Proyecto</PageTitle>
<div>
    <h3>Area de aplicacion - Proyecto</h3>
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @if (!mostrarFormulario)
    {
        <button class="btn btn-primary mb-3" @onclick="NuevoRegistro">+ Nuevo Area de Aplicacion - Proyecto</button>
    }

    @if (mostrarFormulario)
    {
        <div class="card mb-3">
            <div class="card-header">
                @(editando ? "Editar Area de Aplicacion - Proyecto" : "Nuevo Area de Aplicacion - Proyecto")
            </div>
            <div class="card-body">
                <div class="row">

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Proyecto</label>
                        <select class="form-select" @bind="campoProyecto">
                            <option value="0">-- Seleccione un proyecto --</option>
                            @foreach (var proyecto in listaProyectos)
                            {
                                var idProyecto = proyecto["id"]?.ToString() ?? string.Empty;
                                var nombreProyecto = proyecto["titulo"]?.ToString() ?? $"Proyecto {idProyecto}";
                                <option value="@idProyecto">@nombreProyecto</option>
                            }
                        </select>
                        <small class="text-muted">Seleccione un proyecto</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Área de aplicación</label>   
                        <select class="form-select" @bind="campoAreaAplicacion">
                            <option value="0">-- Seleccione un área de aplicación --</option>
                            @foreach (var area in listaAreasAplicacion)
                            {
                                var idArea = area["id"]?.ToString() ?? string.Empty;
                                var nombreArea = area["nombre"]?.ToString() ?? $"Área {idArea}";
                                <option value="@idArea">@nombreArea</option>
                            }
                        </select>
                        <small class="text-muted">seleccione un área de aplicación</small>
                    </div>

                </div>

                <button class="btn btn-success" @onclick="GuardarRegistro">Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    }

    @if (cargando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary"></div>
        </div>
    }

    @if (!cargando && registros.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Proyecto</th>
                    <th>Área de aplicación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in registros)
                {
                    <tr>
                        <td>@reg["proyecto"]</td>
                        <td>@reg["area_aplicacion"]</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1" @onclick="() => EditarRegistro(reg)">Editar</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarRegistro(reg)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!cargando && !registros.Any())
    {
        <div class="alert alert-info">
            No se encontraron registros en la tabla área de aplicación.
        </div>
    }
</div>

@code
{
    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> listaProyectos = new();
    private List<Dictionary<string, object?>> listaAreasAplicacion = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;
    private int campoProyecto = 0;
    private int campoAreaAplicacion = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarRegistros();
        await CargarCatalogos();
    }
    private async Task CargarCatalogos()
    {
        try
        {
            var proyectos = await Api.ListarAsync("proyecto");
            listaProyectos = proyectos ?? new ();

            var areasAplicacion = await Api.ListarAsync("area_aplicacion");
            listaAreasAplicacion = areasAplicacion ?? new ();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar catálogos: {ex.Message}";
            exito = false;
        }
    }

    private async Task CargarRegistros()
    {
        try
        {
            var resultado = await Api.ListarAsync("aa_proyecto");
            registros = resultado ?? new List<Dictionary<string, object?>>();
        }
        catch (Exception ex)
        {
            registros = new List<Dictionary<string, object?>>();
            mensaje = $"No hay registros disponibles, por favor cree uno nuevo. Detalles del error: {ex.Message}";
            exito = false;
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevoRegistro()
    {
        editando = false;
        campoProyecto = 0;
        campoAreaAplicacion = 0;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        editando = true;

        campoProyecto = int.TryParse(reg["proyecto"]?.ToString(), out int proyecto) ? proyecto : 0;
        campoAreaAplicacion = int.TryParse(reg["area_aplicacion"]?.ToString(), out int aa) ? aa : 0;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private async Task GuardarRegistro()
    {
        var datos = new Dictionary<string, object?>
        {
            ["proyecto"] = campoProyecto,
            ["area_aplicacion"] = campoAreaAplicacion
        };

        if (editando)
        {
            datos.Remove("proyecto");

            var resultado = await Api.ActualizarAsync("aa_proyecto", "proyecto", campoProyecto.ToString(), datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }
        else
        {
            var resultado = await Api.CrearAsync("aa_proyecto", datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }

        if (exito)
        {
            await CargarRegistros();
            mostrarFormulario = false;
        }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        string id = reg["proyecto"]?.ToString() ?? string.Empty;

        var resultado = await Api.EliminarAsync("aa_proyecto", "proyecto", id);
        exito = resultado.exito;
        mensaje = resultado.mensaje;

        if (exito)
        {
            await CargarRegistros();
        }
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        mensaje = string.Empty;
    }
}