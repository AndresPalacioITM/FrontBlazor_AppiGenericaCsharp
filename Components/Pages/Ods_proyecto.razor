@page "/Ods_proyecto"
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Objetivo de desarrollo sostenible - Proyecto</PageTitle>
<div class="container mt-4">
    <h3>Objetivo de desarrollo sostenible - Proyecto</h3>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }
    @if (!mostrarFormulario)
    {
        <button class="btn btn-primary mb-3" @onclick="NuevoRegistro">+ Nuevo Ods - Proyecto</button>
    }
    @if (mostrarFormulario)
    {
        <div class="card mb-3">
            <div class="card-header">
                @(editando ? "Editar Ods - Proyecto" : "Nuevo Ods - Proyecto")
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Proyecto</label>
                        <select class="form-select" @bind="campoProyecto">
                            <option value="0">-- Seleccione un proyecto --</option>
                            @foreach (var proy in listaProyectos)
                            {
                                var idProy = Convert.ToInt32(proy["id"]);
                                var titulo = proy["titulo"]?.ToString();
                                <option value="@idProy">@idProy - @titulo</option>
                            }
                        </select>
                        <small class="text-muted">Proyecto a registrar en este ODS</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Id de Objetivo de desarrollo sostenible</label>
                        <select class="form-select" @bind="campoOds">
                            <option value="0">-- Seleccione un Ods --</option>
                            @foreach (var ods in listaOds)
                            {
                                var idOds = Convert.ToInt32(ods["id"]);
                                var nombreOds = ods["nombre"]?.ToString() ?? $"Objetivo de desarrollo sostenible {idOds}";
                                <option value="@idOds">@nombreOds</option>
                            }
                        </select>
                        <small class="text-muted">Seleccione el objetivo de desarrollo sostenible</small>
                    </div>
                </div>
                <button class="btn btn-success me-2" @onclick="GuardarRegistro">Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    }

    @* Spinner *@
    @if (cargando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }

    @* TABLA DE PRODUCTOS *@
    @if (!cargando && registros.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Proyecto</th>
                    <th>Objetivo de desarrollo sostenible</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in registros)
                {
                    <tr>
                        <td>@reg["proyecto"]</td>
                        <td>@reg["ods"]</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1" @onclick="() => EditarRegistro(reg)">Editar</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarRegistro(reg)">Eliminar</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
    }

    @if (!cargando && !registros.Any())
    {
        <div class="alert alert-warning">No se encontraron registros. Haga clic en "Nuevo Ods - Proyecto" para agregar uno.</div>
    }
</div>

@code {
    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> listaOds = new();
    private List<Dictionary<string, object?>> listaProyectos = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;
    private int campoProyecto = 0;
    private int campoOds = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarCatalogos();
        await CargarRegistros();
    }

    private async Task CargarCatalogos()
    {
        try
        {
            var proyectos = await Api.ListarAsync("proyecto");
            listaProyectos = proyectos ?? new();
            var ods = await Api.ListarAsync("objetivo_desarrollo_sostenible");
            listaOds = ods ?? new();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar catálogos: {ex.Message}";
            exito = false;
        }
    }

    private async Task CargarRegistros()
    {
        cargando = true;
        mensaje = string.Empty;
        try
        {
            var resultado = await Api.ListarAsync("ods_proyecto");
            registros = resultado ?? new();
        }
        catch (Exception ex)
        {
            registros = new();
            mensaje = $"No hay registros disponibles, por favor cree uno nuevo. Detalles del error: {ex.Message}";
            exito = false;
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevoRegistro()
    {
        editando = false;        
        campoProyecto = 0;
        campoOds = 0;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        editando = true;
        campoProyecto = Convert.ToInt32(reg["proyecto"]);
        campoOds = Convert.ToInt32(reg["ods"]);
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private async Task GuardarRegistro()
    {
        var datos = new Dictionary<string, object?>
        {
            ["proyecto"] = campoProyecto,
            ["ods"] = campoOds
        };

        if (editando)
        {
            var resultado = await Api.ActualizarAsync("ods_proyecto", "proyecto,ods", $"{campoProyecto},{campoOds}", datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }
        else
        {
            var resultado = await Api.CrearAsync("ods_proyecto", datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }

        if (exito)
        {
            await CargarRegistros();
            mostrarFormulario = false;
        }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        string proyecto = reg["proyecto"]?.ToString() ?? "";
        string ods = reg["ods"]?.ToString() ?? "";
        var resultado = await Api.EliminarAsync("ods_proyecto", "proyecto,ods", $"{proyecto},{ods}");
        exito = resultado.exito;
        mensaje = resultado.mensaje;
        if (exito) await CargarRegistros();
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        mensaje = string.Empty;
    }

    private string FormatearFecha(object? fechaObj)
    {
        if (fechaObj == null) return "";
        if (fechaObj is DateTime dt) return dt.ToString("yyyy-MM-dd");
        if (fechaObj is string str && DateTime.TryParse(str, out DateTime dt2)) return dt2.ToString("yyyy-MM-dd");
        return "";
    }
}