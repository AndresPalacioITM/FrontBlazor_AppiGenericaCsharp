@*Pagina proyecto de la primera entrega*@
@page "/Proyecto"
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Proyecto</PageTitle>

<div class="container mt-4">
    <h3>Proyecto</h3>

    @* ───────── ALERTA DE EXITO O ERROR ───────── *@
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
        </div>
    }

    @* ───────── BOTON PARA MOSTRAR FORMULARIO DE CREAR ───────── *@
    @if (!mostrarFormulario)
    {
        <button class="btn btn-primary mb-3" @onclick="NuevoRegistro">+ Nuevo Proyecto</button>
    }

    @* ───────── FORMULARIO (CREAR / EDITAR) - SIN CAMPO ID ───────── *@
    @if (mostrarFormulario)
    {
        <div class="card mb-3">
            <div class="card-header">
                @(editando ? "Editar Proyecto" : "Nuevo Proyecto")
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Título</label>
                        <input class="form-control" @bind="campoTitulo" />
                        <small class="text-muted">Ingrese el nombre del proyecto</small>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Resumen</label>
                        <textarea class="form-control" rows="3" @bind="campoResumen"></textarea>
                        <small class="text-muted">Ingrese el resumen del proyecto</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Presupuesto (COP)</label>
                        <input class="form-control" type="number" step="0.01" @bind="campoPresupuesto" />
                        <small class="text-muted">Ingrese el valor en COP del proyecto</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tipo de financiación</label>
                        <select class="form-select" @bind="campoTipoFinanciacion">
                            <option value="">Seleccione...</option>
                            <option value="Interna">Interna</option>
                            <option value="Externa">Externa</option>
                            <option value="Cofinanciado">Cofinanciado</option>
                        </select>
                        <small class="text-muted">Financiación fue interna, externa o cofinanciado</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tipo de fondos</label>
                        <select class="form-select" @bind="campoTipoFondos">
                            <option value="">Seleccione...</option>
                            <option value="Público">Público</option>
                            <option value="Privado">Privado</option>
                            <option value="Mixto">Mixto</option>
                        </select>
                        <small class="text-muted">Los fondos fueron de origen público, privado o mixto</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha de inicio</label>
                        <input class="form-control" type="date" @bind="campoFechaInicio" />
                        <small class="text-muted">Seleccione la fecha de inicio</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha de fin</label>
                        <input class="form-control" type="date" @bind="campoFechaFin" />
                        <small class="text-muted">Seleccione la fecha de finalización (activo)</small>
                    </div>
                </div>
                <button class="btn btn-success me-2" @onclick="GuardarRegistro">Guardar</button>
                <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            </div>
        </div>
    }

    @if (cargando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }

    @* ───────── TABLA DE REGISTROS ───────── *@
    @if (!cargando && registros.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Título</th>
                    <th>Resumen</th>
                    <th>Presupuesto (COP) </th>
                    <th>Tipo financiación</th>
                    <th>Tipo fondos</th>
                    <th>Fecha inicio</th>
                    <th>Fecha fin</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in registros)
                {
                    <tr>
                        <td>@reg["id"]</td>
                        <td>@reg["titulo"]</td>
                        <td>@reg["resumen"]</td>
                        <td>@FormatearPresupuesto(reg["presupuesto"])</td>
                        <td>@reg["tipo_financiacion"]</td>
                        <td>@reg["tipo_fondos"]</td>
                        <td>@FormatearFecha(reg["fecha_inicio"])</td>
                        <td>@FormatearFecha(reg["fecha_fin"])</td>                        
                        <td>
                            <button class="btn btn-warning btn-sm me-1"
                                    @onclick="() => EditarRegistro(reg)">
                                Editar
                            </button>
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => EliminarRegistro(reg)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* ───────── MENSAJE CUANDO NO HAY DATOS ───────── *@
    @if (!cargando && !registros.Any())
    {
        <div class="alert alert-warning">No se encontraron registros en la tabla proyecto.</div>
    }
</div>

@code 
{
    // ───────── VARIABLES DE ESTADO ─────────
    private List<Dictionary<string, object?>> registros = new();
    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool editando = false;
    private string mensaje = string.Empty;
    private bool exito = false;

    // Campos del formulario (ID se maneja internamente sin mostrarse)
    private int campoId = 0;          // solo para editar/eliminar
    private string campoTitulo = string.Empty;
    private string campoResumen = string.Empty;
    private double campoPresupuesto = 0;
    private string campoTipoFinanciacion = string.Empty;
    private string campoTipoFondos = string.Empty;
    private DateTime campoFechaInicio = DateTime.Today;
    private DateTime campoFechaFin = DateTime.Today;

    // ───────── CICLO DE VIDA ─────────
    protected override async Task OnInitializedAsync()
    {
        await CargarRegistros();
    }

    // ───────── METODOS ─────────
    private async Task CargarRegistros()
    {
        cargando = true;
        mensaje = string.Empty;
        try
        {
            var resultado = await Api.ListarAsync("proyecto");
            registros = resultado ?? new List<Dictionary<string, object?>>();
        }
        catch (Exception ex)
        {
            registros = new List<Dictionary<string, object?>>();
            mensaje = $"Error al cargar los datos: {ex.Message}";
            exito = false;
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevoRegistro()
    {
        editando = false;
        campoId = 0;
        campoTitulo = string.Empty;
        campoResumen = string.Empty;
        campoPresupuesto = 0;
        campoTipoFinanciacion = string.Empty;
        campoTipoFondos = string.Empty;
        campoFechaInicio = DateTime.Today;
        campoFechaFin = DateTime.Today;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private void EditarRegistro(Dictionary<string, object?> reg)
    {
        editando = true;
        campoId = int.TryParse(reg["id"]?.ToString(), out int id) ? id : 0;
        campoTitulo = reg["titulo"]?.ToString() ?? "";
        campoResumen = reg["resumen"]?.ToString() ?? "";
        campoPresupuesto = double.TryParse(reg["presupuesto"]?.ToString(), out double p) ? p : 0;
        campoTipoFinanciacion = reg["tipo_financiacion"]?.ToString() ?? "";
        campoTipoFondos = reg["tipo_fondos"]?.ToString() ?? "";
        campoFechaInicio = DateTime.TryParse(reg["fecha_inicio"]?.ToString(), out DateTime fInicio) ? fInicio : DateTime.Today;
        campoFechaFin = DateTime.TryParse(reg["fecha_fin"]?.ToString(), out DateTime fFin) ? fFin : DateTime.Today;
        mostrarFormulario = true;
        mensaje = string.Empty;
    }

    private async Task GuardarRegistro()
    {
        var datos = new Dictionary<string, object?>
        {
            ["titulo"] = campoTitulo,
            ["resumen"] = campoResumen,
            ["presupuesto"] = campoPresupuesto,
            ["tipo_financiacion"] = campoTipoFinanciacion,
            ["tipo_fondos"] = campoTipoFondos,
            ["fecha_inicio"] = campoFechaInicio,
            ["fecha_fin"] = campoFechaFin
        };

        if (editando)
        {
            var resultado = await Api.ActualizarAsync("proyecto", "id", campoId.ToString(), datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }
        else
        {
            var resultado = await Api.CrearAsync("proyecto", datos);
            exito = resultado.exito;
            mensaje = resultado.mensaje;
        }

        if (exito)
        {
            mostrarFormulario = false;
            await CargarRegistros();
        }
    }

    private async Task EliminarRegistro(Dictionary<string, object?> reg)
    {
        string id = reg["id"]?.ToString() ?? "";
        if (string.IsNullOrEmpty(id)) return;

        var resultado = await Api.EliminarAsync("proyecto", "id", id);
        exito = resultado.exito;
        mensaje = resultado.mensaje;

        if (exito)
        {
            await CargarRegistros();
        }
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        mensaje = string.Empty;
    }

    private string FormatearFecha(object? fechaObj)
    {
        if (fechaObj == null) return "";
        if(fechaObj is DateTime dt) return dt.ToString("yyyy-MM-dd");
        if(fechaObj is string str && DateTime.TryParse(str, out DateTime dt2)) return dt2.ToString("yyyy-MM-dd");
        return "";
    }

    private string FormatearPresupuesto(object? valor)
{
    if (valor == null) return "$0";
    double numero = Convert.ToDouble(valor);
    // Formato con separadores de miles y sin decimales
    return $"${numero.ToString("#,0").Replace(",", ".")}";
}
}